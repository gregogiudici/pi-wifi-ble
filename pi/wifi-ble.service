[Unit]
Description=Wi-Fi setup over Bluetooth LE (wifi-ble)
Requires=bluetooth.service
Wants=NetworkManager.service
After=bluetooth.service NetworkManager.service dbus.service
# Restart together with bluetoothd: our GATT service and advertisement live inside it.
PartOf=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/wifi-ble/wifi_ble.py --config /etc/wifi-ble/config.json
Restart=always
RestartSec=3

# Runs as root because changing NetworkManager system connections needs it.
# Everything else is locked down.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
